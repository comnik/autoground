%% (assume "the `check` module asks an `Oracle` whether a witness entails a sentence")
%% (assume "the `check` module asks an `Oracle` whether supporting sentences establish a claim's sentence")
%% (assume "`Support::Sentence` wraps a `Box<Proposition>`")
%% (assume "`Proposition` has `And`, `Or`, and `Not` variants, whose operands are other propositions")
%% (assume "`check` computes the value of `and`, `or`, and `not` from the values of their operands, without asking the oracle")
flowchart TB
  brief([brief]) -->|compiles_to| Claim([Claim])
  subgraph oracle [" "]
    direction LR
    Oracle{{Oracle}} -->|implemented_by| JevOracle[JevOracle]
  end
  Claim -->|judged_by| Oracle
  Oracle -->|judges| Support([Support])
  Support -->|comes_from| Witness([Witness])
  Support -->|comes_from| Sentence([Sentence])
  Witness -->|read_through| Universe{{Universe}}
  Sentence -->|combines| Connectives(Connectives)
  Universe -->|implemented_by| Filesystem[Filesystem]
