{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "provenance"],
  "properties": {
    "value": {
      "type": "string",
      "enum": ["true", "false", "unknown"]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "verdict", "excerpt"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": ["entailed", "contradicted"]
          },
          "excerpt": {
            "type": "string",
            "minLength": 12,
            "maxLength": 400
          }
        }
      }
    }
  }
}
