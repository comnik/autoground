(declare CLI "the system has a command-line interface")
(declare Compiler "the system has a compiler for the s-exp representation")
(declare EDBStorage "the system has an storage component to memoized grounded EDB")
(declare TopDownEvaluator "the system has a top-down evaluator for processing rules")

;; Assert that high-level concepts are represented in the codebase, even if they don't map
;; directly to specific sub-directories or files.
(require
 (and
  (CLI)
  (Compiler)
  (EDBStorage)
  (TopDownEvaluator)))