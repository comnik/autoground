;; autoground architecture
;;
;; CLI wires parse → compile → demand-driven eval → tree navigation → report.
;; The Judge answers listing and document questions; it does not run the evaluator.

(declare component "{String} is a (conceptual or concrete) component in the codebase")
(declare knows_about "{component} knows about {component}")

(require
 (and
  (component "CLI")
  (component "Syntax")
  (component "Compiler")
  (component "Store")
  (component "Evaluator")
  (component "Navigator")
  (component "Judge")
  (component "TUI")))

;; Syntax is independent of grounding and evaluation.
(require (not (knows_about "Syntax" "Evaluator")))
(require (not (knows_about "Syntax" "Navigator")))
(require (not (knows_about "Syntax" "Judge")))
(require (not (knows_about "Syntax" "CLI")))

;; Compile does not know the runtime.
(require (not (knows_about "Compiler" "Evaluator")))
(require (not (knows_about "Compiler" "Navigator")))
(require (not (knows_about "Compiler" "Judge")))
(require (not (knows_about "Compiler" "CLI")))

;; Store is a data plane; it does not call eval or the navigator.
(require (not (knows_about "Store" "Evaluator")))
(require (not (knows_about "Store" "Navigator")))
(require (not (knows_about "Store" "Judge")))
(require (not (knows_about "Store" "CLI")))

;; Judge answers questions; it does not drive evaluation or the CLI.
(require (not (knows_about "Judge" "Evaluator")))
(require (not (knows_about "Judge" "CLI")))
(require (not (knows_about "Judge" "Compiler")))

