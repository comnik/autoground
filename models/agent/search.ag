;; Search builds the candidate view for one proposition.
;;
;; A proposition is submitted, and the oracle is asked when the session
;; waits. Waiting on a submitted proposition flushes every proposition
;; still pending. The flush walks every directory in the universe,
;; renders each listing once, and packs those directories into a shared
;; child-name tree of at most 48 KiB and 100 directories. The
;; root is a key in that tree. A directory is also a name in its parent,
;; with a trailing slash. A file appears only as a name in its parent.
;;
;; Each proposition then adds one question per directory, on that same
;; state, so propositions in the flush share the listing. The question
;; is a probability of yes, and the text is: is the subtree at this path
;; irrelevant to the proposition? Yes means a reader looking for
;; information about the proposition would skip the subtree. No means
;; that reader would open it. The question also carries the directory's
;; own listing: a path header and child names on a repository, the prompt
;; text on a transcript. Search reads that probability and stores its
;; complement, one minus P(irrelevant), as the directory's relevance
;; signal. A fixed floor turns that probability into keep or prune.
;;
;; A directory drops when its own irrelevance is at least 0.70, which is
;; a signal of at most 0.30. A descendant's answer does not move its
;; parent. A pruned ancestor drops the directories under it, including
;; one its own answer would have kept. The root is never asked and never
;; drops. A file is never asked. A file stays while the directory that
;; contains it stays, and a file whose parent is the root always stays.
;; What search returns is a clone restricted to the surviving directories
;; and the files under them. The session universe stays the whole tree.
;;
;; The stored signal is the ranking a later reader uses: higher first,
;; path order when two directories tie. The window itself is a set.
;; Search reads no file body and returns no true, false, or unknown.
;; The reader judges bodies inside this window. Search drops a directory
;; only on a confident skip, and the reader treats what remains as a
;; closed world.
;; Composite claims are split before they reach search. The navigator
;; remains the walk behind `autoground run`.

(declare component "{String} is a component in the codebase")
(declare proposition "{String} is a proposition submitted to search")
(declare directory "{String} is a directory in the universe")
(declare file "{String} is a file in the universe")
(declare database "{String} is a database in the universe")

(declare calls "{component} calls {component}")
(declare reads_body "{component} reads file bodies")
(declare returns_verdict "{component} returns true, false, or unknown")
(declare writes_store "{component} writes grounded facts")
(declare narrows_session "{component} removes databases from the shared universe")
(declare asks_on_submit "{component} asks the oracle when a proposition is submitted")
(declare asks_irrelevance "{component} asks whether a subtree is irrelevant to a proposition")
(declare chooses_keep "{component} asks the oracle to choose keep or prune")
(declare splits_composite "{component} splits a composite proposition into atoms")
(declare subsumes "{component} subsumes {component}")
(declare judges_window_of "{component} judges the window produced by {component}")

(declare root "{directory} is the root of the universe")
(declare parent "{directory} is the parent of {database}")
(declare same_flush "{proposition} is flushed together with {proposition}")
(declare shares_listing "{proposition} shares a directory listing with {proposition}")

;; P(irrelevant) for this directory alone is at least 0.70.
;; The weakest answer under the directory plays no part in this.
(declare confidently_irrelevant "{directory} is confidently irrelevant to {proposition}")

;; Search put a question to the oracle about this database for this proposition.
(declare classified "{database} is classified for {proposition}")

;; The database is in the pruned universe search returns.
(declare returned "{database} is returned for {proposition}")

(require
  (and
    (component "Search")
    (component "Universe")
    (component "Oracle")
    (component "Reader")
    (component "Navigator")
    (component "Log")
    (component "Store")))

;; Search calls the universe for listings, the oracle for one irrelevance
;; probability per directory, and the log for the steps of the flush.
(require (calls "Search" "Universe"))
(require (calls "Search" "Oracle"))
(require (calls "Search" "Log"))

;; The flush asks. Submit only enqueues. The question is the irrelevance
;; probability; keep and prune are not labels the oracle chooses.
(require (asks_irrelevance "Search"))
(require (not (asks_on_submit "Search")))
(require (not (chooses_keep "Search")))

;; Bodies, verdicts, and grounded facts belong to the reader and the store.
;; The shared universe stays intact; the window is a clone.
(require (not (reads_body "Search")))
(require (not (returns_verdict "Search")))
(require (not (writes_store "Search")))
(require (not (narrows_session "Search")))
(require (not (splits_composite "Search")))

;; The reader is who decides the proposition from this window.
;; Search does not replace the navigator.
(require (judges_window_of "Reader" "Search"))
(require (returns_verdict "Reader"))
(require (not (subsumes "Search" "Navigator")))

(require
  (forall [f]
    (implies (file f) (database f))))

(require
  (forall [d]
    (implies (directory d) (database d))))

;; Every directory except the root is classified, including a directory
;; whose parent will later be pruned. Files are not classified.
(require
  (forall [d p]
    (implies
      (and (directory d) (proposition p) (not (root d)))
      (classified d p))))

(require
  (forall [d p]
    (implies
      (and (directory d) (proposition p) (root d))
      (not (classified d p)))))

(require
  (forall [f p]
    (implies
      (and (file f) (proposition p))
      (not (classified f p)))))

;; A confident irrelevance is an answer search actually asked for.
(require
  (forall [d p]
    (implies
      (and (directory d) (proposition p) (confidently_irrelevant d p))
      (classified d p))))

;; Propositions flushed together share one listing.
(require
  (forall [p q]
    (implies
      (and (proposition p) (proposition q) (same_flush p q))
      (shares_listing p q))))

;; Own answer, or a parent the same rule already dropped.
(def pruned [d p]
  (or
    (confidently_irrelevant d p)
    (exists [a]
      (and
        (parent a d)
        (pruned a p)))))

;; A non-root directory survives when it is not pruned.
;; A file survives when its parent directory is not pruned.
;; The root has no parent, so a file there survives.
(def in_window [x p]
  (or
    (and
      (directory x)
      (not (root x))
      (not (pruned x p)))
    (and
      (file x)
      (not
        (exists [d]
          (and
            (parent d x)
            (pruned d p)))))))

(require
  (forall [d p]
    (implies
      (and (root d) (proposition p))
      (not (pruned d p)))))

;; The clone's database set is that window, neither larger nor smaller.
(require
  (forall [x p]
    (implies
      (and (database x) (proposition p) (returned x p))
      (in_window x p))))

(require
  (forall [x p]
    (implies
      (and (database x) (proposition p) (in_window x p))
      (returned x p))))
