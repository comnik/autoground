(declare component "{String} is a component in the codebase")
(declare file "{String} is a file in the codebase")
(declare includes "{file} includes or imports {file}")
(declare belongs_to "{file} belongs to {component}")

(require
  (and
    (component "Frontend")
    (component "Backend")))

;; A derivation rule defining the relationship `depends_on`.
;; Note how `file` and `includes` are undefined atoms.
(def depends_on [x y]
  (and
    (component x)
    (component y)
    (or
      (exists [f1 f2]
        (and
          (file f1)
          (file f2)
          (belongs_to f1 x)
          (belongs_to f2 y)
          (includes f1 f2))))))

;; A relationship `depends_on` connecting the two components.
(require
  (depends_on "Frontend" "Backend"))

;; An integrity constraint asserting that the architectural layering must not be violated.
(require
  (not (depends_on "Backend" "Frontend")))

;; An integrity constraint asserting that there should be no circular dependencies.
(require
  (forall [x y]
    (implies
      (depends_on x y)
      (not (depends_on y x)))))
